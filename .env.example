# Если ключи не заданы, приложение сгенерирует их при первом запуске и допишет в .env.
# Потеряете ENCRYPTION_KEY — не расшифруете сохранённые пароли.
SECRET_KEY=
ENCRYPTION_KEY=
# По умолчанию SQLite-файл passguard.db в корне проекта. Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/passguard
TOKEN_TTL_MINUTES=720
